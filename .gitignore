# --- Rust/Cargo ---
# The target directory contains all compiled artifacts, dependencies, and build files.
# It can grow to gigabytes, so definitely do not commit this!
target/

# These are backup files generated by rustfmt when formatting code
**/*.rs.bk

# --- Windows/MSVC ---
# Compilation on Windows creates heavy program database files for debugging
*.pdb

# --- IDEs and Editors ---
# IntelliJ / RustRover / VS Code configuration files
.idea/
.vscode/
*.iml

# OS-specific files
.DS_Store
Thumbs.db